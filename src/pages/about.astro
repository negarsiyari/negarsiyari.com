---
/**
 * ABOUT PAGE
 * -----------------------------------------------------------------------------
 * Your fuller story. The opening bio comes from site.config.ts (longBio).
 *
 * PHOTOS — real images you simply REPLACE (keep the import names), or swap the
 * imports below for different files in src/assets/:
 *   • Portrait at top:   src/assets/portrait.jpg   (~800×1000, 4:5)
 *   • Story gallery:     your classroom photos, imported below. Edit each
 *     caption — that's where the citizenship-celebration context goes.
 *   Want fewer/more photos? Add or remove items in the `story` array.
 *
 * The education timeline is the `milestones` list — edit/extend freely.
 */
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import TextBlock from "@/components/TextBlock.astro";
import Timeline from "@/components/Timeline.astro";
import { site } from "@/config/site.config";
import portrait from "@/assets/portrait.jpg";
import storyFlags from "@/assets/IMG_9060_Original.jpg";
import storyPreCna from "@/assets/IMG_0479_Original.jpg";

// Story photos. Replace the imports above and write a caption for each.
const story = [
  {
    img: storyFlags,
    alt: "Negar with her adult ESOL class, students holding small U.S. flags",
    caption:
      "Celebrating my class: Afghan women who arrived with no formal schooling and no literacy in their first language, and finished this course mastering all 100 questions on the U.S. citizenship test"
  },
  {
    img: storyPreCna,
    alt: "Pre-CNA graduation at the International Institute of New England in Lowell, MA",
    caption:
      "Pre-CNA graduation at the International Institute of New England - Lowell, MA.",
  },
];

// Education + selected milestones. Edit/extend as you like.
const milestones = [
  {
    date: "2024",
    title: "PhD, Linguistics (Applied)",
    detail: "Georgetown University, Washington, DC",
  },
  {
    date: "2022",
    title: "MS, Linguistics",
    detail: "Georgetown University, Washington, DC",
  },
  {
    date: "2019",
    title: "MA, English as a Second Language",
    detail: "University of Arizona, Tucson, AZ",
  },
  {
    date: "2017",
    title: "BA, English Language & Literature",
    detail: "Shahid Beheshti University, Tehran, Iran",
  },
];
---

<BaseLayout
  title="About"
  description="About Negar Siyari, language educator and applied linguistics researcher."
>
  <Container width="wide">
    <div class="grid gap-12 py-16 sm:py-20 md:grid-cols-[1fr_0.75fr] md:items-start">
      <div>
        <p class="text-xs uppercase tracking-[0.18em] text-faint">About</p>
        <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">
          I work where language learning, displacement, and technology meet.
        </h1>
        <TextBlock class="mt-8">
          <p>{site.longBio}</p>
          <p>            I grew up in Tehran, Iran, and moved to Tucson, AZ for my MA, then to Georgetown for my doctorate. And somehwere along the way, teaching English to newly arrived adults stopped being a volunteering experience, and became the whole point.
          </p>
          <p>
            Across teaching and research, I'm interested in what learners can do
            when instruction starts from their actual lives: work goals, family
            responsibilities, digital systems, institutional barriers, and the
            desire to participate more fully in a new community.
          </p>
          <p>
            My current work asks how generative AI can be taught responsibly to
            multilingual adults — especially learners who are often left out of
            emerging-technology conversations.
          </p>
        </TextBlock>
      </div>

      <Image
        src={portrait}
        alt={`Portrait of ${site.name}`}
        class="aspect-[4/5] w-full rounded-2xl border border-line object-cover"
        loading="eager"
      />
    </div>
  </Container>

  <!-- Story gallery -->
  <Section eyebrow="My work, up close" title="In pictures" width="wide">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        story.map((item) => (
          <figure>
            <Image
              src={item.img}
              alt={item.alt}
              class="aspect-[4/3] w-full rounded-xl border border-line object-cover"
              loading="lazy"
            />
            <figcaption class="mt-3 text-sm text-muted">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </Section>

  <Section eyebrow="Background" title="Education">
    <Timeline items={milestones} />
  </Section>
</BaseLayout>
