---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <Container width="narrow">
    <div class="py-24 sm:py-32">
      <p class="text-xs uppercase tracking-[0.18em] text-faint">404</p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">
        Page not found
      </h1>
      <p class="mt-5 max-w-xl text-lg text-muted">
        The page you are looking for may have moved, or the link may be out of
        date.
      </p>
      <div class="mt-8">
        <Button href="/" variant="primary">Return home</Button>
      </div>
    </div>
  </Container>
</BaseLayout>
