---
/**
 * PUBLICATIONS INDEX
 * -----------------------------------------------------------------------------
 * Lists scholarly output from src/data/publications.ts.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import PublicationList from "@/components/PublicationList.astro";
import { publications } from "@/data/publications";
---

<BaseLayout
  title="Publications"
  description="Scholarly publications by Negar Siyari."
>
  <Container width="wide">
    <div class="pt-16 pb-10 sm:pt-20">
      <p class="text-xs uppercase tracking-[0.18em] text-faint">Publications</p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">
        Research and publications
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        Peer-reviewed articles, book chapters, and books on language education,
        refugee learning, AI literacy, and applied linguistics.
      </p>
    </div>

    <section class="pb-14">
      <PublicationList publications={publications} />
    </section>
  </Container>
</BaseLayout>
