---
/**
 * CONTACT PAGE
 * -----------------------------------------------------------------------------
 * Quiet and simple. Links come from site.config.ts (links). No form, no email
 * by design — LinkedIn is the front door.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import SocialLinks from "@/components/SocialLinks.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Negar Siyari."
>
  <Container width="narrow">
    <div class="py-20 sm:py-28">
      <p class="text-xs uppercase tracking-[0.18em] text-faint">Contact</p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">
        Get in touch
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted">
        I'm always glad to connect about language education, AI literacy,
        research, or collaboration. LinkedIn is the best place to reach me; you
        can also read my published research on Google Scholar.
      </p>

      <div class="mt-10">
        <p class="mb-4 text-xs uppercase tracking-wider text-faint">Find me on</p>
        <SocialLinks layout="stack" />
      </div>
    </div>
  </Container>
</BaseLayout>
