---
/**
 * PROJECTS INDEX
 * -----------------------------------------------------------------------------
 * Lists all projects from src/content/projects/. To add one, drop a new .mdx
 * file there — it appears here automatically, ordered by the `order` field.
 */
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import ProjectGrid from "@/components/ProjectGrid.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Projects"
  description="Projects by Negar Siyari — applied work in language education, AI literacy, and research."
>
  <Container width="wide">
    <div class="pt-16 pb-10 sm:pt-20">
      <p class="text-xs uppercase tracking-[0.18em] text-faint">Projects</p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">
        Things I've built and studied
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        A descriptive look at the work — what it was, why it mattered, and what
        I learned. (For papers and citations, see <a href="/publications" class="text-accent underline underline-offset-4">Publications</a>.)
      </p>
    </div>

    <div class="pb-8">
      <ProjectGrid projects={projects} />
    </div>
  </Container>
</BaseLayout>
