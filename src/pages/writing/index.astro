---
/**
 * WRITING INDEX
 * -----------------------------------------------------------------------------
 * Lists published essays from src/content/writing/ and publications from the
 * simple data file in src/data/publications.ts.
 */
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import WritingList from "@/components/WritingList.astro";
import PublicationList from "@/components/PublicationList.astro";
import { publications } from "@/data/publications";

const posts = (await getCollection("writing"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Writing"
  description="Essays and publications by Negar Siyari."
>
  <Container width="wide">
    <div class="pt-16 pb-10 sm:pt-20">
      <p class="text-xs uppercase tracking-[0.18em] text-faint">Writing</p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">
        Essays and publications
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        Research, essays, and notes on language education, refugee learning,
        AI literacy, and applied linguistics.
      </p>
    </div>

    <section class="pb-14">
      <h2 class="font-display text-2xl font-semibold">Publications</h2>
      <div class="mt-6">
        <PublicationList publications={publications} />
      </div>
    </section>

    <section class="border-t border-line py-14">
      <h2 class="font-display text-2xl font-semibold">Essays</h2>
      <div class="mt-6">
        <WritingList posts={posts} />
      </div>
    </section>
  </Container>
</BaseLayout>
