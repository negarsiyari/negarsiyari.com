---
/**
 * CaseStudySection.astro — a labeled section inside a project case study.
 * Use within an .mdx project file:
 *
 *   <CaseStudySection title="The challenge">
 *     ...prose...
 *   </CaseStudySection>
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="mt-12 first:mt-0">
  <h2 class="font-display text-2xl font-semibold">{title}</h2>
  <div class="prose mt-4">
    <slot />
  </div>
</section>
