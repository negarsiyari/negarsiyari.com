---
/**
 * TextBlock.astro — a column of readable prose. Wrap paragraphs/markdown.
 * Use inside a Section, or standalone. Applies the editorial `.prose` styles.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`prose ${className}`}>
  <slot />
</div>
