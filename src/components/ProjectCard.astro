---
/**
 * ProjectCard.astro — one project in a list/grid. Links to its detail page.
 * Descriptive by design: shows title, summary, year, role, tags — no
 * external/download links (those don't belong in Projects).
 */
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { title, summary, year, role, status, tags } = project.data;

const statusLabel: Record<string, string> = {
  active: "Active",
  ongoing: "Ongoing",
  completed: "Completed",
};
---

<a
  href={`/projects/${project.id}`}
  class="group flex flex-col rounded-xl border border-line bg-surface-2/40 p-6 transition-colors hover:border-accent"
>
  <div class="flex items-center justify-between gap-4 text-xs text-faint">
    <span class="uppercase tracking-wider">{year}</span>
    <span
      class="rounded-full border border-line px-2.5 py-0.5 text-[11px] uppercase tracking-wider"
    >
      {statusLabel[status]}
    </span>
  </div>

  <h3 class="mt-4 font-display text-xl font-semibold group-hover:text-accent">
    {title}
  </h3>
  {role && <p class="mt-1 text-sm text-faint">{role}</p>}
  <p class="mt-3 text-muted">{summary}</p>

  {
    tags.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="rounded-full bg-surface-2 px-2.5 py-1 text-xs text-muted">
            {tag}
          </li>
        ))}
      </ul>
    )
  }

  <span
    class="mt-5 inline-flex items-center gap-1 text-sm text-accent opacity-0 transition-opacity group-hover:opacity-100"
  >
    Read more
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
</a>
