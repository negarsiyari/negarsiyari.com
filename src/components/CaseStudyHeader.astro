---
/**
 * CaseStudyHeader.astro — the top of a project detail page.
 * Shows title, summary, and a small meta row (year / role / status).
 * Used automatically by the project page template.
 */
import Container from "./Container.astro";

interface Props {
  title: string;
  summary: string;
  year: string;
  role?: string;
  status?: string;
  tags?: string[];
}
const { title, summary, year, role, status, tags = [] } = Astro.props;

const statusLabel: Record<string, string> = {
  active: "Active",
  ongoing: "Ongoing",
  completed: "Completed",
};
---

<header class="pt-16 pb-10 sm:pt-20">
  <Container width="narrow">
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      All projects
    </a>

    <h1 class="mt-6 font-display text-4xl font-semibold sm:text-5xl">{title}</h1>
    <p class="mt-5 text-xl text-muted">{summary}</p>

    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-t border-line pt-6 text-sm">
      <div>
        <dt class="text-faint uppercase tracking-wider text-xs">Year</dt>
        <dd class="mt-1">{year}</dd>
      </div>
      {role && (
        <div>
          <dt class="text-faint uppercase tracking-wider text-xs">Role</dt>
          <dd class="mt-1">{role}</dd>
        </div>
      )}
      {status && (
        <div>
          <dt class="text-faint uppercase tracking-wider text-xs">Status</dt>
          <dd class="mt-1">{statusLabel[status] ?? status}</dd>
        </div>
      )}
    </dl>

    {
      tags.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full bg-surface-2 px-3 py-1 text-xs text-muted">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </Container>
</header>
