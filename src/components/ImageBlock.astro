---
/**
 * ImageBlock.astro — a figure with an optional caption.
 * For local images, import them and pass the imported value to `src`.
 * Always provide meaningful `alt` text (describe the image's content/purpose).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** "wide" breaks out of the reading column; "default" stays inline. */
  width?: "default" | "wide";
}
const { src, alt, caption, width = "default" } = Astro.props;
---

<figure class={width === "wide" ? "my-12" : "my-8"}>
  <Image
    src={src}
    alt={alt}
    class="w-full rounded-xl border border-line"
    loading="lazy"
  />
  {caption && <figcaption class="mt-3 text-sm text-faint">{caption}</figcaption>}
</figure>
