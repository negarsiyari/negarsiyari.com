---
/**
 * PublicationList.astro — your publications, from src/data/publications.ts.
 * Forthcoming pieces get a "Forthcoming" badge and (per your choice) don't
 * show a venue/publisher until you fill one in.
 */
import { publications } from "@/data/publications";

const kindLabel: Record<string, string> = {
  article: "Article",
  chapter: "Book chapter",
  book: "Book",
};
---

<ul class="divide-y divide-line">
  {
    publications.map((pub) => (
      <li class="py-6">
        <div class="flex flex-wrap items-center gap-3 text-xs">
          <span class="uppercase tracking-wider text-faint">
            {kindLabel[pub.kind]}
          </span>
          <span class="text-faint">{pub.year}</span>
          {pub.forthcoming && (
            <span class="rounded-full border border-accent/40 px-2.5 py-0.5 text-[11px] uppercase tracking-wider text-accent">
              Forthcoming
            </span>
          )}
        </div>

        <h3 class="mt-3 max-w-3xl font-display text-lg font-semibold">
          {pub.link ? (
            <a
              href={pub.link}
              class="hover:text-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              {pub.title}
            </a>
          ) : (
            pub.title
          )}
        </h3>

        <p class="mt-2 max-w-2xl text-muted">{pub.description}</p>

        {pub.venue && <p class="mt-2 text-sm text-faint italic">{pub.venue}</p>}
      </li>
    ))
  }
</ul>
